generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ENUMS

enum UserRole {
  VIEWER
  CREATOR
  ADMIN
}

enum AuthClientType {
  WEB
  IOS
  ANDROID
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

enum MediaQuality {
  ORIGINAL
  HIGH
  MEDIUM
  LOW
  PREVIEW
}

enum PostVisibility {
  PUBLIC
  SUBSCRIBER_ONLY
  WAITING
  DELETING
}

// MODELS

model User {
  id          String  @id @default(uuid())
  email       String  @unique
  username    String  @unique
  displayName String? @map("display_name")
  bio         String?
  avatarUrl   String? @map("avatar_url")
  coverUrl    String? @map("cover_url")
  isVerified  Boolean @default(false) @map("is_verified")

  role UserRole @default(VIEWER)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  posts         Post[]         @relation("UserPosts")
  comments      Comment[]      @relation("UserComments")
  votes         Vote[]
  awardsGiven   Award[]        @relation("awardedBy")
  notifications Notification[]
  authSessions  AuthSession[]

  followers Follow[] @relation("UserFollowers")
  following Follow[] @relation("UserFollowing")

  @@map("users")
}

model AuthSession {
  id                    String         @id @default(uuid())
  userId                String         @map("user_id")
  refreshTokenHash      String         @unique @map("refresh_token_hash")
  clientType            AuthClientType @map("client_type")
  deviceName            String?        @map("device_name")
  userAgent             String?        @map("user_agent")
  lastUsedAt            DateTime       @default(now()) @map("last_used_at")
  refreshTokenExpiresAt DateTime       @map("refresh_token_expires_at")
  expiresAt             DateTime       @map("expires_at")
  revokedAt             DateTime?      @map("revoked_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHistory RefreshTokenHistory[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model RefreshTokenHistory {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  tokenHash String   @unique @map("token_hash")
  usedAt    DateTime @default(now()) @map("used_at")
  expiresAt DateTime @map("expires_at")

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_token_history")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("UserFollowing", fields: [followerId], references: [id])
  following User @relation("UserFollowers", fields: [followingId], references: [id])

  @@unique([followerId, followingId], map: "follows_follower_id_following_id_key")
  @@map("follows")
}

model Soma {
  id                 String  @id @default(uuid())
  slug               String  @unique
  name               String
  description        String?
  coverUrl           String? @map("cover_url")
  memberCount        Int     @default(0) @map("member_count")
  weeklyVisitorCount Int     @default(0) @map("weekly_visitor_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  posts Post[]

  @@map("somas")
}

model Post {
  id       String  @id @default(uuid())
  title    String
  body     String?
  excerpt  String?
  mediaUrl String? @map("media_url")

  authorId    String         @map("author_id")
  somaId      String         @map("soma_id")
  impressions Int            @default(0)
  visibility  PostVisibility @default(WAITING)

  voteCount    Int   @default(0) @map("vote_count")
  commentCount Int   @default(0) @map("comment_count")
  hotScore     Float @default(0) @map("hot_score")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author User @relation("UserPosts", fields: [authorId], references: [id], onDelete: Cascade)
  soma   Soma @relation(fields: [somaId], references: [id], onDelete: Cascade)

  comments      Comment[]
  media         MediaCollection?
  votes         Vote[]
  awards        Award[]
  notifications Notification[]

  @@map("posts")
}

model Comment {
  id      String @id @default(uuid())
  content String

  authorId        String  @map("author_id")
  postId          String  @map("post_id")
  parentCommentId String? @map("parent_comment_id")

  voteCount Int @default(0) @map("vote_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author        User           @relation("UserComments", fields: [authorId], references: [id], onDelete: Cascade)
  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent        Comment?       @relation("CommentToComment", fields: [parentCommentId], references: [id], onDelete: Cascade)
  children      Comment[]      @relation("CommentToComment")
  votes         Vote[]
  awards        Award[]
  notifications Notification[]

  @@map("comments")
}

model Vote {
  id     String @id @default(uuid())
  userId String @map("user_id")

  postId    String? @map("post_id")
  commentId String? @map("comment_id")

  value Int // +1 or -1

  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@map("votes")
}

model MediaCollection {
  id     String @id @default(uuid())
  postId String @unique(map: "media_collections_post_id_key") @map("post_id")

  createdAt DateTime @default(now()) @map("created_at")

  post  Post        @relation(fields: [postId], references: [id])
  items MediaItem[]

  @@map("media_collections")
}

model MediaItem {
  id           String @id @default(uuid())
  collectionId String @map("collection_id")

  type        MediaType
  originalUrl String    @map("original_url")
  s3Key       String    @map("s3_key")
  metadata    Json?

  createdAt DateTime @default(now()) @map("created_at")

  collection MediaCollection @relation(fields: [collectionId], references: [id])
  variants   MediaVariant[]

  @@map("media_items")
}

model MediaVariant {
  id          String @id @default(uuid())
  mediaItemId String @map("media_item_id")

  quality MediaQuality
  url     String

  width    Int?
  height   Int?
  bitrate  Int?
  duration Float?

  createdAt DateTime @default(now()) @map("created_at")

  mediaItem MediaItem @relation(fields: [mediaItemId], references: [id])

  @@map("media_variants")
}

model Award {
  id String @id @default(uuid())

  awardedById String  @map("awarded_by_id")
  postId      String? @map("post_id")
  commentId   String? @map("comment_id")

  name String // e.g. "Gold", "EditorPick"

  createdAt DateTime @default(now()) @map("created_at")

  awardedBy User     @relation("awardedBy", fields: [awardedById], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@map("awards")
}

model Notification {
  id     String @id @default(uuid())
  userId String @map("user_id")

  type    String // e.g. "COMMENT", "AWARD"
  message String

  postId    String? @map("post_id")
  commentId String? @map("comment_id")

  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
