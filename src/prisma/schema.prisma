generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ENUMS

enum UserRole {
  VIEWER
  CREATOR
  ADMIN
}

enum AuthProvider {
  GOOGLE
}

enum AuthClientType {
  WEB
  IOS
  ANDROID
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

enum MediaQuality {
  ORIGINAL
  HIGH
  MEDIUM
  LOW
  PREVIEW
}

enum MediaProcessingStatus {
  NONE
  PENDING
  READY
  FAILED
}

enum MediaUploadPurpose {
  POST_MEDIA
  PROFILE_AVATAR
  PROFILE_BANNER
}

enum MediaAssetStatus {
  UPLOAD_PENDING
  UPLOADED
  PROCESSING
  READY
  FAILED
  REJECTED
  DELETED
}

enum PostVisibility {
  DRAFT
  SUBMITTED
  NEEDS_CHANGES
  APPROVED
  PUBLISHED
  REJECTED
  REMOVED
  ARCHIVED
}

enum SomaMembershipRole {
  MEMBER
  CREATOR
  MODERATOR
  OWNER
}

enum SomaMembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LEFT
}

enum SomaMembershipMode {
  OPEN
  REQUEST
  INVITE_ONLY
}

enum SomaCreatorApplicationStatus {
  SUBMITTED
  IN_REVIEW
  NEEDS_INFO
  APPROVED
  DECLINED
  WITHDRAWN
}

enum SomaAccessAuditAction {
  APPLICATION_REVIEWED
  MEMBERSHIP_GRANTED
  MEMBERSHIP_ROLE_CHANGED
  MEMBERSHIP_STATUS_CHANGED
}

// MODELS

model User {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  platformRole  UserRole @default(VIEWER) @map("platform_role")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile                UserProfile?
  authAccounts           AuthAccount[]
  posts                  Post[]         @relation("UserPosts")
  comments               Comment[]      @relation("UserComments")
  votes                  Vote[]
  awardsGiven            Award[]        @relation("awardedBy")
  receivedNotifications  Notification[] @relation("NotificationRecipient")
  triggeredNotifications Notification[] @relation("NotificationActor")
  authSessions           AuthSession[]
  authHandoffs           AuthHandoff[]

  followers Follow[] @relation("UserFollowers")
  following Follow[] @relation("UserFollowing")

  somaMemberships          SomaMembership[]         @relation("SomaMember")
  approvedSomaMemberships  SomaMembership[]         @relation("SomaMembershipApprover")
  somaApplications         SomaCreatorApplication[] @relation("SomaApplicationApplicant")
  reviewedSomaApplications SomaCreatorApplication[] @relation("SomaApplicationReviewer")
  savedPosts               SavedPost[]
  collections              Collection[]
  mediaAssets              MediaAsset[]            @relation("OwnedMediaAssets")

  @@map("users")
}

model UserProfile {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  username    String   @unique
  displayName String?  @map("display_name")
  bio         String?
  avatarUrl   String?  @map("avatar_url")
  coverUrl    String?  @map("cover_url")
  avatarAssetId String? @unique @map("avatar_asset_id") @db.Uuid
  bannerAssetId String? @unique @map("banner_asset_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarAsset MediaAsset? @relation("ProfileAvatarAsset", fields: [avatarAssetId], references: [id], onDelete: SetNull)
  bannerAsset MediaAsset? @relation("ProfileBannerAsset", fields: [bannerAssetId], references: [id], onDelete: SetNull)

  @@map("user_profiles")
}

model AuthAccount {
  id                String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id")
  providerEmail     String?      @map("provider_email")
  emailVerified     Boolean      @default(false) @map("email_verified")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model AuthHandoff {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("auth_handoffs")
}

model AuthSession {
  id         String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  clientType AuthClientType @map("client_type")
  deviceName String?        @map("device_name")
  userAgent  String?        @map("user_agent")
  lastUsedAt DateTime       @default(now()) @map("last_used_at")
  expiresAt  DateTime       @map("expires_at")
  revokedAt  DateTime?      @map("revoked_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  issuedAt  DateTime  @default(now()) @map("issued_at")
  expiresAt DateTime  @map("expires_at")
  rotatedAt DateTime? @map("rotated_at")
  revokedAt DateTime? @map("revoked_at")

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, rotatedAt])
  @@index([expiresAt])
  @@map("refresh_token_history")
}

model Follow {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("UserFollowing", fields: [followerId], references: [id])
  following User @relation("UserFollowers", fields: [followingId], references: [id])

  @@unique([followerId, followingId], map: "follows_follower_id_following_id_key")
  @@map("follows")
}

model Soma {
  id                 String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug               String             @unique
  name               String
  description        String?
  coverUrl           String?            @map("cover_url")
  memberCount        Int                @default(0) @map("member_count")
  weeklyVisitorCount Int                @default(0) @map("weekly_visitor_count")
  membershipMode     SomaMembershipMode @default(OPEN) @map("membership_mode")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  posts               Post[]
  memberships         SomaMembership[]
  creatorApplications SomaCreatorApplication[]

  @@map("somas")
}

model Post {
  id       String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  title    String
  body     String?
  excerpt  String?
  mediaUrl String? @map("media_url")

  authorId            String                @map("author_id") @db.Uuid
  somaId              String                @map("soma_id") @db.Uuid
  creatorMembershipId String?               @map("creator_membership_id") @db.Uuid
  impressions         Int                   @default(0)
  visibility          PostVisibility        @default(DRAFT)
  mediaStatus         MediaProcessingStatus @default(NONE) @map("media_status")

  voteCount    Int   @default(0) @map("vote_count")
  commentCount Int   @default(0) @map("comment_count")
  hotScore     Float @default(0) @map("hot_score")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author            User            @relation("UserPosts", fields: [authorId], references: [id], onDelete: Cascade)
  soma              Soma            @relation(fields: [somaId], references: [id], onDelete: Cascade)
  creatorMembership SomaMembership? @relation(fields: [creatorMembershipId], references: [id], onDelete: SetNull)

  comments        Comment[]
  media           MediaCollection?
  votes           Vote[]
  awards          Award[]
  savedBy         SavedPost[]
  collectionItems CollectionItem[]
  mediaAttachments PostMediaAttachment[]

  @@index([visibility, hotScore, id])
  @@map("posts")
}

model MediaAsset {
  id              String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerId         String             @map("owner_id") @db.Uuid
  purpose         MediaUploadPurpose
  type            MediaType
  status          MediaAssetStatus   @default(UPLOAD_PENDING)
  stagingKey      String             @unique @map("staging_key")
  fileName        String             @map("file_name")
  declaredMimeType String             @map("declared_mime_type")
  declaredByteSize BigInt             @map("declared_byte_size")
  mimeType        String?            @map("mime_type")
  byteSize        BigInt?            @map("byte_size")
  checksum        String?
  metadata        Json?
  uploadedAt      DateTime?          @map("uploaded_at")
  processedAt     DateTime?          @map("processed_at")
  expiresAt       DateTime           @map("expires_at")
  failureCode     String?            @map("failure_code")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  owner           User               @relation("OwnedMediaAssets", fields: [ownerId], references: [id], onDelete: Cascade)
  variants        MediaAssetVariant[]
  postAttachments PostMediaAttachment[]
  avatarFor       UserProfile[]      @relation("ProfileAvatarAsset")
  bannerFor       UserProfile[]      @relation("ProfileBannerAsset")

  @@index([ownerId, status, createdAt])
  @@index([status, expiresAt])
  @@map("media_assets")
}

model MediaAssetVariant {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  assetId     String   @map("asset_id") @db.Uuid
  name        String
  storageKey  String   @unique @map("storage_key")
  mimeType    String   @map("mime_type")
  byteSize    BigInt?  @map("byte_size")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  asset       MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, name])
  @@map("media_asset_variants")
}

model PostMediaAttachment {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  postId      String   @map("post_id") @db.Uuid
  assetId     String   @map("asset_id") @db.Uuid
  position    Int
  altText     String?  @map("alt_text")
  caption     String?
  createdAt   DateTime @default(now()) @map("created_at")

  post        Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  asset       MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([postId, assetId])
  @@unique([postId, position])
  @@index([assetId])
  @@map("post_media_attachments")
}

model SavedPost {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt])
  @@map("saved_posts")
}

model Collection {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String
  description String?
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]

  @@index([userId, updatedAt])
  @@map("collections")
}

model CollectionItem {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  collectionId String   @map("collection_id") @db.Uuid
  postId       String   @map("post_id") @db.Uuid
  position     Int
  createdAt    DateTime @default(now()) @map("created_at")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  post       Post       @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([collectionId, postId])
  @@index([collectionId, position])
  @@map("collection_items")
}

model SomaMembership {
  id     String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  somaId String @map("soma_id") @db.Uuid

  role   SomaMembershipRole
  status SomaMembershipStatus @default(ACTIVE)

  approvedById String?   @map("approved_by_id") @db.Uuid
  approvedAt   DateTime? @map("approved_at")
  suspendedAt  DateTime? @map("suspended_at")
  leftAt       DateTime? @map("left_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user       User   @relation("SomaMember", fields: [userId], references: [id], onDelete: Cascade)
  soma       Soma   @relation(fields: [somaId], references: [id], onDelete: Cascade)
  approvedBy User?  @relation("SomaMembershipApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  posts      Post[]

  @@unique([userId, somaId])
  @@index([somaId, role, status])
  @@map("soma_memberships")
}

model SomaCreatorApplication {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  applicantId String @map("applicant_id") @db.Uuid
  somaId      String @map("soma_id") @db.Uuid

  portfolioUrls     String[] @default([]) @map("portfolio_urls")
  disciplines       String[] @default([])
  statement         String
  processSamples    String[] @default([]) @map("process_samples")
  moderationConsent Boolean  @map("moderation_consent")

  status       SomaCreatorApplicationStatus @default(SUBMITTED)
  reviewerId   String?                      @map("reviewer_id") @db.Uuid
  reviewerNote String?                      @map("reviewer_note")
  reviewedAt   DateTime?                    @map("reviewed_at")
  createdAt    DateTime                     @default(now()) @map("created_at")
  updatedAt    DateTime                     @updatedAt @map("updated_at")

  applicant User  @relation("SomaApplicationApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  soma      Soma  @relation(fields: [somaId], references: [id], onDelete: Cascade)
  reviewer  User? @relation("SomaApplicationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@unique([applicantId, somaId])
  @@index([somaId, status, createdAt])
  @@map("soma_creator_applications")
}

model SomaAccessAuditLog {
  id           String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  somaId       String                @map("soma_id") @db.Uuid
  actorId      String                @map("actor_id") @db.Uuid
  targetUserId String                @map("target_user_id") @db.Uuid
  action       SomaAccessAuditAction
  metadata     Json?
  createdAt    DateTime              @default(now()) @map("created_at")

  @@index([somaId, createdAt])
  @@map("soma_access_audit_logs")
}

model Comment {
  id      String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  content String

  authorId        String  @map("author_id") @db.Uuid
  postId          String  @map("post_id") @db.Uuid
  parentCommentId String? @map("parent_comment_id") @db.Uuid

  voteCount Int @default(0) @map("vote_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author   User      @relation("UserComments", fields: [authorId], references: [id], onDelete: Cascade)
  post     Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentToComment", fields: [parentCommentId], references: [id], onDelete: Cascade)
  children Comment[] @relation("CommentToComment")
  votes    Vote[]
  awards   Award[]

  @@map("comments")
}

model Vote {
  id     String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  postId    String? @map("post_id") @db.Uuid
  commentId String? @map("comment_id") @db.Uuid

  value Int // +1 or -1

  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@map("votes")
}

model MediaCollection {
  id     String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  postId String @unique(map: "media_collections_post_id_key") @map("post_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  post  Post        @relation(fields: [postId], references: [id])
  items MediaItem[]

  @@map("media_collections")
}

model MediaItem {
  id           String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  collectionId String @map("collection_id") @db.Uuid

  type        MediaType
  originalUrl String    @map("original_url")
  s3Key       String    @map("s3_key")
  metadata    Json?

  createdAt DateTime @default(now()) @map("created_at")

  collection MediaCollection @relation(fields: [collectionId], references: [id])
  variants   MediaVariant[]

  @@map("media_items")
}

model MediaVariant {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  mediaItemId String @map("media_item_id") @db.Uuid

  quality MediaQuality
  url     String

  width    Int?
  height   Int?
  bitrate  Int?
  duration Float?

  createdAt DateTime @default(now()) @map("created_at")

  mediaItem MediaItem @relation(fields: [mediaItemId], references: [id])

  @@map("media_variants")
}

model Award {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  awardedById String  @map("awarded_by_id") @db.Uuid
  postId      String? @map("post_id") @db.Uuid
  commentId   String? @map("comment_id") @db.Uuid

  name String // e.g. "Gold", "EditorPick"

  createdAt DateTime @default(now()) @map("created_at")

  awardedBy User     @relation("awardedBy", fields: [awardedById], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@map("awards")
}

model Notification {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  recipientId   String    @map("recipient_id") @db.Uuid
  actorId       String?   @map("actor_id") @db.Uuid
  eventType     String    @map("event_type")
  eventData     Json      @map("event_data")
  sourceEventId String    @unique @map("source_event_id")
  readAt        DateTime? @map("read_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, createdAt])
  @@map("notifications")
}
