generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ENUMS

enum UserRole {
  VIEWER
  CREATOR
  ADMIN
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

enum VoteTargetType {
  POST
  COMMENT
}

enum MediaQuality {
  ORIGINAL
  HIGH
  MEDIUM
  LOW
  PREVIEW
}

enum AwardTargetType {
  POST
  COMMENT
}

enum PostVisibility {
  PUBLIC
  SUBSCRIBER_ONLY
  WAITING
  DELETING
}

// MODELS

model User {
  id          String  @id @default(uuid())
  email       String  @unique
  username    String  @unique
  displayName String? @map("display_name")
  bio         String?

  role UserRole @default(VIEWER)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  posts         Post[]
  comments      Comment[]
  votes         Vote[]
  awardsGiven   Award[]        @relation("awardedBy")
  notifications Notification[]

  followers Follow[] @relation("UserFollowers")
  following Follow[] @relation("UserFollowing")

  @@map("users")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("UserFollowing", fields: [followerId], references: [id])
  following User @relation("UserFollowers", fields: [followingId], references: [id])

  @@unique([followerId, followingId], map: "follows_follower_id_following_id_key")
  @@map("follows")
}

model Soma {
  id          String  @id @default(uuid())
  slug        String  @unique
  name        String
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  posts Post[]

  @@map("somas")
}

model Post {
  id    String  @id @default(uuid())
  title String
  body  String?

  authorId    String         @map("author_id")
  somaId      String         @map("soma_id")
  impressions Int            @default(0)
  visibility  PostVisibility @default(WAITING)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author User @relation(fields: [authorId], references: [id])
  soma   Soma @relation(fields: [somaId], references: [id])

  comments Comment[]
  media    MediaCollection?

  @@map("posts")
}

model Comment {
  id      String @id @default(uuid())
  content String

  authorId        String  @map("author_id")
  postId          String  @map("post_id")
  parentCommentId String? @map("parent_comment_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author   User      @relation(fields: [authorId], references: [id])
  post     Post      @relation(fields: [postId], references: [id])
  parent   Comment?  @relation("CommentToComment", fields: [parentCommentId], references: [id])
  children Comment[] @relation("CommentToComment")

  @@map("comments")
}

model Vote {
  id     String @id @default(uuid())
  userId String @map("user_id")

  targetType VoteTargetType @map("target_type")
  targetId   String         @map("target_id")

  value Int // +1 or -1

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, targetType, targetId], map: "votes_user_id_target_type_target_id_key")
  @@map("votes")
}

model MediaCollection {
  id     String @id @default(uuid())
  postId String @unique(map: "media_collections_post_id_key") @map("post_id")

  createdAt DateTime @default(now()) @map("created_at")

  post  Post        @relation(fields: [postId], references: [id])
  items MediaItem[]

  @@map("media_collections")
}

model MediaItem {
  id           String @id @default(uuid())
  collectionId String @map("collection_id")

  type        MediaType
  originalUrl String    @map("original_url")
  s3Key       String    @map("s3_key")
  metadata    Json?

  createdAt DateTime @default(now()) @map("created_at")

  collection MediaCollection @relation(fields: [collectionId], references: [id])
  variants   MediaVariant[]

  @@map("media_items")
}

model MediaVariant {
  id          String @id @default(uuid())
  mediaItemId String @map("media_item_id")

  quality MediaQuality
  url     String

  width    Int?
  height   Int?
  bitrate  Int?
  duration Float?

  createdAt DateTime @default(now()) @map("created_at")

  mediaItem MediaItem @relation(fields: [mediaItemId], references: [id])

  @@map("media_variants")
}

model Award {
  id String @id @default(uuid())

  awardedById String          @map("awarded_by_id")
  targetType  AwardTargetType @map("target_type")
  targetId    String          @map("target_id")

  name String // e.g. "Gold", "EditorPick"

  createdAt DateTime @default(now()) @map("created_at")

  awardedBy User @relation("awardedBy", fields: [awardedById], references: [id])

  @@map("awards")
}

model Notification {
  id     String @id @default(uuid())
  userId String @map("user_id")

  type    String // e.g. "COMMENT", "AWARD"
  message String

  targetType String? @map("target_type") // e.g. "POST", "COMMENT"
  targetId   String? @map("target_id")

  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}
