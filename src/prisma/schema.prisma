generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ENUMS

enum UserRole {
  VIEWER
  CREATOR
  ADMIN
}

enum AuthClientType {
  WEB
  IOS
  ANDROID
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

enum MediaQuality {
  ORIGINAL
  HIGH
  MEDIUM
  LOW
  PREVIEW
}

enum MediaProcessingStatus {
  NONE
  PENDING
  READY
  FAILED
}

enum PostVisibility {
  DRAFT
  SUBMITTED
  NEEDS_CHANGES
  APPROVED
  PUBLISHED
  REJECTED
  REMOVED
  ARCHIVED
}

enum SomaMembershipRole {
  CREATOR
  MODERATOR
  OWNER
}

enum SomaMembershipStatus {
  ACTIVE
  SUSPENDED
  LEFT
}

enum SomaCreatorApplicationStatus {
  SUBMITTED
  IN_REVIEW
  NEEDS_INFO
  APPROVED
  DECLINED
  WITHDRAWN
}

enum SomaAccessAuditAction {
  APPLICATION_REVIEWED
  MEMBERSHIP_GRANTED
  MEMBERSHIP_ROLE_CHANGED
  MEMBERSHIP_STATUS_CHANGED
}

// MODELS

model User {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email       String  @unique
  username    String  @unique
  displayName String? @map("display_name")
  bio         String?
  avatarUrl   String? @map("avatar_url")
  coverUrl    String? @map("cover_url")
  isVerified  Boolean @default(false) @map("is_verified")

  role UserRole @default(VIEWER)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  posts         Post[]         @relation("UserPosts")
  comments      Comment[]      @relation("UserComments")
  votes         Vote[]
  awardsGiven   Award[]        @relation("awardedBy")
  notifications Notification[]
  authSessions  AuthSession[]
  authHandoffs  AuthHandoff[]

  followers Follow[] @relation("UserFollowers")
  following Follow[] @relation("UserFollowing")

  somaMemberships         SomaMembership[]         @relation("SomaMember")
  approvedSomaMemberships SomaMembership[]         @relation("SomaMembershipApprover")
  somaApplications        SomaCreatorApplication[] @relation("SomaApplicationApplicant")
  reviewedSomaApplications SomaCreatorApplication[] @relation("SomaApplicationReviewer")

  @@map("users")
}

model AuthHandoff {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("auth_handoffs")
}

model AuthSession {
  id         String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  clientType AuthClientType @map("client_type")
  deviceName String?        @map("device_name")
  userAgent  String?        @map("user_agent")
  lastUsedAt DateTime       @default(now()) @map("last_used_at")
  expiresAt  DateTime       @map("expires_at")
  revokedAt  DateTime?      @map("revoked_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  issuedAt  DateTime  @default(now()) @map("issued_at")
  expiresAt DateTime  @map("expires_at")
  rotatedAt DateTime? @map("rotated_at")
  revokedAt DateTime? @map("revoked_at")

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, rotatedAt])
  @@index([expiresAt])
  @@map("refresh_token_history")
}

model Follow {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("UserFollowing", fields: [followerId], references: [id])
  following User @relation("UserFollowers", fields: [followingId], references: [id])

  @@unique([followerId, followingId], map: "follows_follower_id_following_id_key")
  @@map("follows")
}

model Soma {
  id                 String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug               String  @unique
  name               String
  description        String?
  coverUrl           String? @map("cover_url")
  memberCount        Int     @default(0) @map("member_count")
  weeklyVisitorCount Int     @default(0) @map("weekly_visitor_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  posts Post[]
  memberships         SomaMembership[]
  creatorApplications SomaCreatorApplication[]

  @@map("somas")
}

model Post {
  id       String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  title    String
  body     String?
  excerpt  String?
  mediaUrl String? @map("media_url")

  authorId    String         @map("author_id") @db.Uuid
  somaId      String         @map("soma_id") @db.Uuid
  creatorMembershipId String? @map("creator_membership_id") @db.Uuid
  impressions Int            @default(0)
  visibility  PostVisibility @default(DRAFT)
  mediaStatus MediaProcessingStatus @default(NONE) @map("media_status")

  voteCount    Int   @default(0) @map("vote_count")
  commentCount Int   @default(0) @map("comment_count")
  hotScore     Float @default(0) @map("hot_score")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author User @relation("UserPosts", fields: [authorId], references: [id], onDelete: Cascade)
  soma   Soma @relation(fields: [somaId], references: [id], onDelete: Cascade)
  creatorMembership SomaMembership? @relation(fields: [creatorMembershipId], references: [id], onDelete: SetNull)

  comments      Comment[]
  media         MediaCollection?
  votes         Vote[]
  awards        Award[]
  notifications Notification[]

  @@map("posts")
}

model SomaMembership {
  id     String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  somaId String @map("soma_id") @db.Uuid

  role   SomaMembershipRole
  status SomaMembershipStatus @default(ACTIVE)

  approvedById String?   @map("approved_by_id") @db.Uuid
  approvedAt   DateTime? @map("approved_at")
  suspendedAt  DateTime? @map("suspended_at")
  leftAt       DateTime? @map("left_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user       User  @relation("SomaMember", fields: [userId], references: [id], onDelete: Cascade)
  soma       Soma  @relation(fields: [somaId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("SomaMembershipApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  posts      Post[]

  @@unique([userId, somaId])
  @@index([somaId, role, status])
  @@map("soma_memberships")
}

model SomaCreatorApplication {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  applicantId String @map("applicant_id") @db.Uuid
  somaId      String @map("soma_id") @db.Uuid

  portfolioUrls  String[] @default([]) @map("portfolio_urls")
  disciplines    String[] @default([])
  statement      String
  processSamples String[] @default([]) @map("process_samples")
  moderationConsent Boolean @map("moderation_consent")

  status       SomaCreatorApplicationStatus @default(SUBMITTED)
  reviewerId   String?   @map("reviewer_id") @db.Uuid
  reviewerNote String?   @map("reviewer_note")
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  applicant User  @relation("SomaApplicationApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  soma      Soma  @relation(fields: [somaId], references: [id], onDelete: Cascade)
  reviewer  User? @relation("SomaApplicationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@unique([applicantId, somaId])
  @@index([somaId, status, createdAt])
  @@map("soma_creator_applications")
}

model SomaAccessAuditLog {
  id           String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  somaId       String @map("soma_id") @db.Uuid
  actorId      String @map("actor_id") @db.Uuid
  targetUserId String @map("target_user_id") @db.Uuid
  action       SomaAccessAuditAction
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([somaId, createdAt])
  @@map("soma_access_audit_logs")
}

model Comment {
  id      String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  content String

  authorId        String  @map("author_id") @db.Uuid
  postId          String  @map("post_id") @db.Uuid
  parentCommentId String? @map("parent_comment_id") @db.Uuid

  voteCount Int @default(0) @map("vote_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author        User           @relation("UserComments", fields: [authorId], references: [id], onDelete: Cascade)
  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent        Comment?       @relation("CommentToComment", fields: [parentCommentId], references: [id], onDelete: Cascade)
  children      Comment[]      @relation("CommentToComment")
  votes         Vote[]
  awards        Award[]
  notifications Notification[]

  @@map("comments")
}

model Vote {
  id     String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  postId    String? @map("post_id") @db.Uuid
  commentId String? @map("comment_id") @db.Uuid

  value Int // +1 or -1

  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@map("votes")
}

model MediaCollection {
  id     String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  postId String @unique(map: "media_collections_post_id_key") @map("post_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  post  Post        @relation(fields: [postId], references: [id])
  items MediaItem[]

  @@map("media_collections")
}

model MediaItem {
  id           String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  collectionId String @map("collection_id") @db.Uuid

  type        MediaType
  originalUrl String    @map("original_url")
  s3Key       String    @map("s3_key")
  metadata    Json?

  createdAt DateTime @default(now()) @map("created_at")

  collection MediaCollection @relation(fields: [collectionId], references: [id])
  variants   MediaVariant[]

  @@map("media_items")
}

model MediaVariant {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  mediaItemId String @map("media_item_id") @db.Uuid

  quality MediaQuality
  url     String

  width    Int?
  height   Int?
  bitrate  Int?
  duration Float?

  createdAt DateTime @default(now()) @map("created_at")

  mediaItem MediaItem @relation(fields: [mediaItemId], references: [id])

  @@map("media_variants")
}

model Award {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  awardedById String  @map("awarded_by_id") @db.Uuid
  postId      String? @map("post_id") @db.Uuid
  commentId   String? @map("comment_id") @db.Uuid

  name String // e.g. "Gold", "EditorPick"

  createdAt DateTime @default(now()) @map("created_at")

  awardedBy User     @relation("awardedBy", fields: [awardedById], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@map("awards")
}

model Notification {
  id     String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  type    String // e.g. "COMMENT", "AWARD"
  message String

  postId    String? @map("post_id") @db.Uuid
  commentId String? @map("comment_id") @db.Uuid

  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
