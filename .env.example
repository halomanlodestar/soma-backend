# Database
DATABASE_URL="postgresql://user:password@localhost:5432/soma"

# Server
PORT=8000

# JWT
JWT_SECRET="your-super-secret-jwt-key-min-16-chars"
REFRESH_TOKEN_HMAC_SECRET="a-separate-random-secret-at-least-32-characters"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:8000/auth/google/callback"

# Backblaze B2 storage + Cloudflare delivery
# B2 is S3-compatible. Keep these values secret and never commit .env.
B2_S3_ENDPOINT="https://s3.us-west-004.backblazeb2.com"
B2_REGION="us-west-004"
B2_KEY_ID="your-b2-key-id"
B2_APPLICATION_KEY="your-b2-application-key"
B2_STAGING_BUCKET="soma-staging"
B2_PUBLIC_BUCKET="soma-media"
MEDIA_DELIVERY_ORIGIN="https://media.soma.art"
MEDIA_UPLOAD_URL_TTL_SECONDS=600

# Legacy S3-compatible fallback (optional; omit when using B2 values above)
# S3_BUCKET="your-bucket-name"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID="your-access-key-id"
# S3_SECRET_ACCESS_KEY="your-secret-access-key"
