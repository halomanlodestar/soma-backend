# Database
DATABASE_URL="postgresql://user:password@localhost:5432/soma"

# Server
PORT=8000

# JWT
JWT_SECRET="your-super-secret-jwt-key-min-16-chars"
REFRESH_TOKEN_HMAC_SECRET="a-separate-random-secret-at-least-32-characters"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:8000/auth/google/callback"

# Redis
# Use REDIS_URL for hosted Redis. Use rediss:// when TLS is enabled, and URL-encode
# credentials that contain reserved URL characters (for example, @, :, /, or #).
# REDIS_URL="rediss://default:your-url-encoded-password@redis.example.com:6379"
# These are the local Redis fallback values when REDIS_URL is not set.
REDIS_HOST="localhost"
REDIS_PORT=6379

# Private S3-compatible storage
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# Public Backblaze B2 storage + CDN delivery
# B2 is S3-compatible. Keep credentials secret and never commit .env.
PUBLIC_S3_BUCKET=""
PUBLIC_S3_REGION=""
PUBLIC_S3_ENDPOINT=""
PUBLIC_S3_ACCESS_KEY_ID=""
PUBLIC_S3_SECRET_ACCESS_KEY=""

PUBLIC_ASSET_BASE_URL=""
MEDIA_UPLOAD_URL_TTL_SECONDS=600
